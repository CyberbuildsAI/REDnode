{
  "name": "rednode-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docs:api": "npm run docs --workspace rednode",
    "docs:game": "node tools/gameapi/build.mjs",
    "gameapi:import": "node tools/gameapi/import.mjs",
    "overlay": "npm start --workspace @rednode/overlay",
    "overlay:window": "npm run window --workspace @rednode/overlay",
    "overlay:package": "node tools/overlay/package-host.mjs",
    "release:zip": "node tools/release/nexus-zip.mjs"
  },
  "devDependencies": {
    "marked": "18.1.0"
  }
}
