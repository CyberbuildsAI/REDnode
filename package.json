{
  "name": "rednode-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docs:api": "npm run docs --workspace rednode",
    "theme:package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && cd tools/vscode-theme && vsce package --no-dependencies --out ../../dist/",
    "docs:game": "node tools/gameapi/build.mjs",
    "gameapi:import": "node tools/gameapi/import.mjs",
    "overlay": "npm start --workspace @rednode/overlay",
    "overlay:window": "npm run window --workspace @rednode/overlay"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "marked": "18.1.0"
  }
}
