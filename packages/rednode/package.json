{
  "name": "rednode",
  "version": "0.24.0",
  "description": "Node.js API for scripting Cyberpunk 2077",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "node ../../tools/gameapi/types.mjs",
    "build": "npm run gen && tsc -p tsconfig.json",
    "typecheck": "npm run gen && tsc -p tsconfig.json --noEmit",
    "docs": "npm run gen && typedoc"
  },
  "devDependencies": {
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
